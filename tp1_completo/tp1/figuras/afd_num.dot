digraph "AFD de NUM = D+ (subconjuntos)" {
  rankdir=LR; node [shape=circle, fontname="Helvetica"];
  edge [fontname="Helvetica"]; __ini [shape=point, label=""];
  q0 [shape=circle];
  q1 [shape=doublecircle, xlabel="NUM"];
  q2 [shape=doublecircle, xlabel="NUM"];
  __ini -> q0;
  q0 -> q1 [label="D"];
  q1 -> q2 [label="D"];
  q2 -> q2 [label="D"];
}
